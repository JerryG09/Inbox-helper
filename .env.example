# Copy to .env.local (git-ignored) and fill in locally. Never commit real values.

# Web app processing mode: "simulated" (default when unset) or "anthropic".
# "anthropic" without a key is reported as unavailable; it never falls back to simulated output.
INBOX_PROCESSING_MODE=simulated
# Server-only. Never exposed to the browser, responses or logs.
ANTHROPIC_API_KEY=
# Server-controlled model for the web app (default claude-haiku-5-5). The browser cannot override it.
ANTHROPIC_MODEL=claude-haiku-5-5

# Note: the Day 1 CLI evaluation runner (npm run eval:llm) reads ANTHROPIC_API_KEY/ANTHROPIC_MODEL too and keeps
# its own historical defaults; set ANTHROPIC_MODEL explicitly when you run it.
